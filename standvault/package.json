{
  "name": "standvault",
  "version": "0.1.0",
  "private": true,
  "description": "Personal 3D asset library for exhibition stand design (3ds Max 2026, V-Ray and Corona).",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix app run dev",
    "import": "npm --prefix app run import",
    "backup": "npm --prefix app run backup",
    "scan": "npm run scan:files && npm run scan:meta && npm run scan:archives && npm run scan:inventory",
    "test:naming": "node --test config/naming.test.js",
    "check-name": "node config/check-name.js",
    "init-library": "node config/init-library.js",
    "scan:files": "node scanner/find-files.js",
    "scan:meta": "node scanner/read-metadata.js",
    "scan:archives": "node scanner/scan-archives.js",
    "scan:inventory": "node scanner/build-inventory.js",
    "test": "node --test config/naming.test.js && npm --prefix app test"
  },
  "dependencies": {
    "cfb": "^1.2.2"
  }
}

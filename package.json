{
  "name": "pulsefit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-env.js",
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/watch-api.js",
    "dev:web": "vite",
    "db:setup": "node scripts/ensure-env.js && node --env-file=.env db/setup.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^11.11.0",
    "jose": "^6.2.13",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "express": "^5.3.0",
    "postcss": "^8.4.47",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10",
    "vitest": "^3.2.7"
  }
}
